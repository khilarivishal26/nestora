# ==============================================================================
# Nestora — Environment Configuration Template
# Copy this file to .env and fill in real values. Never commit .env to source control.
# ==============================================================================

# Server Environment
PORT=8080
NODE_ENV=development

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb://127.0.0.1:27017/nestora

# Session Security
SESSION_SECRET=your_long_random_session_secret_key_here

# Cloudinary (Property Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Mapbox (Interactive Property Location Maps)
MAPBOX_TOKEN=your_mapbox_public_token

# Razorpay Payment Gateway (Test / Live Credentials)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_signing_secret
