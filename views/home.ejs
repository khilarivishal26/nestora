<% layout("layouts/boilerplate") %>

<section class="hero-section">
  <div class="hero-content">
    <h1>Find your place. Feel at home.</h1>
    <p>Discover unique stays across India — villas, cottages, resorts, and more.</p>

    <form action="/listings" method="GET" class="hero-search">
      <input
        type="text"
        name="q"
        placeholder="Where do you want to go?"
        aria-label="Search destinations"
      />
      <button type="submit" class="btn btn-primary">Search</button>
    </form>

    <div class="quick-filters">
      <a href="/listings?propertyType=hotel" class="quick-filter-btn">🏨 Hotels</a>
      <a href="/listings?propertyType=villa" class="quick-filter-btn">🏡 Villas</a>
      <a href="/listings?propertyType=resort" class="quick-filter-btn">🏖️ Resorts</a>
      <a href="/listings?propertyType=cottage" class="quick-filter-btn">🛖 Cottages</a>
      <a href="/listings?propertyType=apartment" class="quick-filter-btn">🏢 Apartments</a>
      <a href="/listings?propertyType=homestay" class="quick-filter-btn">🏠 Homestays</a>
    </div>
  </div>
</section>