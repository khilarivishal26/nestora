  <div class="host-cta-banner">
    <div class="host-cta-content">
      <span class="badge badge-booking-status badge-pending" style="font-size: 0.85rem; padding: 4px 14px; margin-bottom: 12px;">
        BECOME A NESTORA HOST
      </span>
      <h2 style="color: var(--white); font-size: 2rem; margin: 0 0 12px 0;">
        Earn by sharing your space
