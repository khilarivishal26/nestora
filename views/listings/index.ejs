<% layout("layouts/boilerplate") %>

<section class="container" style="padding: 40px 24px;">

  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 28px;">
    <h1 style="color: var(--forest-green); margin: 0;">
      <%= typeof isMyPage !== "undefined" && isMyPage ? "My Properties" : "Explore Stays" %>
    </h1>

    <% if (typeof currentUser !== "undefined" && currentUser && (currentUser.role === "host" || currentUser.role === "admin")) { %>
      <a href="/listings/new" class="btn btn-primary">+ Add Property</a>
    <% } %>
  </div>

  <%# ---------- Search & Filter Panel (public Explore page only) ---------- %>
  <% if (typeof isMyPage === "undefined" || !isMyPage) { %>
    <% const qv = typeof query !== "undefined" ? query : {}; %>

    <form action="/listings" method="GET" class="search-section card">

      <%# -- Search bar -- %>
      <div class="search-bar">
        <input type="text" name="q" placeholder="Search by location, title, or keyword..."
               value="<%= qv.q || '' %>" />
        <button type="submit" class="btn btn-primary">Search</button>
      </div>

      <%# -- Filter row -- %>
      <div class="filter-row">

        <div class="filter-group">
          <label for="propertyType">Property Type</label>
          <select name="propertyType" id="propertyType">
            <option value="">All types</option>
            <% ["hotel", "villa", "resort", "cottage", "apartment", "homestay"].forEach(function(t) { %>
              <option value="<%= t %>" <%= qv.propertyType === t ? 'selected' : '' %>><%= t.charAt(0).toUpperCase() + t.slice(1) %></option>
            <% }) %>
          </select>
        </div>

        <div class="filter-group">
          <label for="minPrice">Min Price (₹)</label>
          <input type="number" name="minPrice" id="minPrice" min="0" step="100"
                 placeholder="0" value="<%= qv.minPrice || '' %>" />
        </div>

        <div class="filter-group">
          <label for="maxPrice">Max Price (₹)</label>
          <input type="number" name="maxPrice" id="maxPrice" min="0" step="100"
                 placeholder="Any" value="<%= qv.maxPrice || '' %>" />
        </div>

        <div class="filter-group">
          <label for="guests">Guests</label>
          <select name="guests" id="guests">
            <option value="">Any</option>
            <% for (let i = 1; i <= 10; i++) { %>
              <option value="<%= i %>" <%= qv.guests == i ? 'selected' : '' %>><%= i %>+</option>
            <% } %>
          </select>
        </div>

        <div class="filter-group">
          <label for="bedrooms">Bedrooms</label>
          <select name="bedrooms" id="bedrooms">
            <option value="">Any</option>
            <% for (let i = 1; i <= 5; i++) { %>
              <option value="<%= i %>" <%= qv.bedrooms == i ? 'selected' : '' %>><%= i %>+</option>
            <% } %>
          </select>
        </div>

        <div class="filter-group">
          <label for="country">Country</label>
          <input type="text" name="country" id="country"
                 placeholder="e.g. India" value="<%= qv.country || '' %>" />
        </div>

        <div class="filter-group">
          <label for="amenities">Amenities</label>
          <input type="text" name="amenities" id="amenities"
                 placeholder="e.g. WiFi, Pool" value="<%= qv.amenities || '' %>" />
        </div>

        <div class="filter-group">
          <label for="sort">Sort By</label>
          <select name="sort" id="sort">
            <option value="" <%= !qv.sort ? 'selected' : '' %>>Newest</option>
            <option value="price_asc" <%= qv.sort === 'price_asc' ? 'selected' : '' %>>Price: Low → High</option>
            <option value="price_desc" <%= qv.sort === 'price_desc' ? 'selected' : '' %>>Price: High → Low</option>
          </select>
        </div>

      </div>

      <%# -- Action buttons -- %>
      <div class="filter-actions">
        <button type="submit" class="btn btn-primary">Apply Filters</button>
        <% if (typeof hasFilters !== "undefined" && hasFilters) { %>
          <a href="/listings" class="btn btn-secondary">Clear All</a>
        <% } %>
      </div>
    </form>

    <%# -- Results count -- %>
    <div class="results-count">
      <% if (typeof hasFilters !== "undefined" && hasFilters) { %>
        Showing <strong><%= listings.length %></strong> result<%= listings.length !== 1 ? 's' : '' %>
      <% } else { %>
        <strong><%= listings.length %></strong> propert<%= listings.length !== 1 ? 'ies' : 'y' %> available
      <% } %>
    </div>
  <% } %>

  <%# ---------- Listing grid ---------- %>
  <% if (listings.length === 0) { %>
    <div class="card" style="text-align: center; padding: 48px 24px;">
      <% if (typeof hasFilters !== "undefined" && hasFilters) { %>
        <p style="font-size: 1.1rem; color: #666;">No properties match your search.</p>
        <a href="/listings" class="btn btn-secondary" style="margin-top: 12px;">Clear filters</a>
      <% } else if (typeof isMyPage !== "undefined" && isMyPage) { %>
        <p style="font-size: 1.1rem; color: #666;">No properties found.</p>
        <a href="/listings/new" class="btn btn-primary" style="margin-top: 12px;">List your first property</a>
      <% } else { %>
        <p style="font-size: 1.1rem; color: #666;">No properties available yet.</p>
      <% } %>
    </div>
  <% } else { %>
    <div class="listing-grid">
      <% listings.forEach(function(listing) { %>
        <% const isFav = (typeof wishlistListingIds !== 'undefined' && Array.isArray(wishlistListingIds) && wishlistListingIds.includes(listing._id.toString())); %>
        <div class="card listing-card property-card-v2">
          <div class="listing-card-img property-card-media-wrap">
            <% if (listing.images && listing.images.length > 0) { %>
              <img src="<%= listing.images[0] %>" alt="<%= listing.title %>" loading="lazy" />
            <% } else { %>
              <div class="listing-card-placeholder">No Image</div>
            <% } %>

            <%# Favorite heart button toggle %>
            <button type="button"
                    class="property-card-favorite-btn <%= isFav ? 'active' : '' %>"
                    data-listing-id="<%= listing._id %>"
                    aria-label="<%= isFav ? 'Remove from wishlist' : 'Save to wishlist' %>"
                    title="<%= isFav ? 'Remove from wishlist' : 'Save to wishlist' %>"
                    onclick="toggleWishlist(event, '<%= listing._id %>')">
              ♥
            </button>

            <%# Property Type Badge %>
            <span class="property-card-type-tag">
              <%= listing.propertyType %>
            </span>
          </div>

          <a href="/listings/<%= listing._id %>" class="listing-card-body" style="text-decoration: none; color: inherit; display: block;">
            <p class="listing-card-location" style="margin: 0 0 4px 0;">📍 <%= listing.location %>, <%= listing.country %></p>
            <h3 class="listing-card-title" style="margin: 0 0 8px 0; font-size: 1.15rem; color: var(--forest-green);"><%= listing.title %></h3>
            <div class="listing-card-footer">
              <span class="listing-card-price">₹<%= listing.price.toLocaleString() %> <small>/ night</small></span>
              <span style="font-size: 0.85rem; color: #777;">👥 Up to <%= listing.maxGuests %> guests</span>
            </div>

            <% if (typeof showStatus !== "undefined" && showStatus) { %>
              <div style="margin-top: 8px;">
                <span class="badge badge-status badge-<%= listing.status %>"><%= listing.status %></span>
              </div>
            <% } %>
          </a>
        </div>
      <% }) %>
    </div>
  <% } %>

</section>
