<% layout("layouts/boilerplate") %>

<section class="container" style="padding: 40px 24px;">
  <div class="listing-detail">

    <%# ---------- Image gallery ---------- %>
    <div class="listing-images">
      <% if (listing.images && listing.images.length > 0) { %>
        <% listing.images.forEach(function(img, i) { %>
          <div class="listing-image-item">
            <img src="<%= img %>" alt="<%= listing.title %> — image <%= i + 1 %>" />
          </div>
        <% }) %>
      <% } else { %>
        <div class="listing-image-placeholder">
          <p>No images uploaded</p>
        </div>
      <% } %>
    </div>

    <%# ---------- Main info ---------- %>
    <div class="listing-info card">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 8px;">
        <div>
          <h1 style="color: var(--forest-green); margin: 0 0 4px 0;"><%= listing.title %></h1>
          <p style="color: #666; margin: 0;"><%= listing.location %>, <%= listing.country %></p>
        </div>
        <div style="text-align: right;">
          <span style="font-size: 1.5rem; font-weight: 700; color: var(--forest-green);">
            ₹<%= listing.price.toLocaleString() %>
          </span>
          <span style="color: #666;"> / night</span>
        </div>
      </div>

      <%# Status badge (visible to owner/admin for non-approved) %>
      <% if (listing.status !== "approved") { %>
        <div style="margin-top: 12px;">
          <span class="badge badge-status badge-<%= listing.status %>"><%= listing.status %></span>
        </div>
      <% } %>

      <hr style="border: none; border-top: 1px solid #eee; margin: 20px 0;" />

      <div class="listing-meta">
        <span class="badge badge-type"><%= listing.propertyType %></span>
        <span>👥 <%= listing.maxGuests %> guest<%= listing.maxGuests !== 1 ? "s" : "" %></span>
        <span>🛏️ <%= listing.bedrooms %> bedroom<%= listing.bedrooms !== 1 ? "s" : "" %></span>
        <span>🛁 <%= listing.bathrooms %> bathroom<%= listing.bathrooms !== 1 ? "s" : "" %></span>
      </div>

      <h3 style="margin-top: 24px;">About this property</h3>
      <p style="line-height: 1.7; white-space: pre-line;"><%= listing.description %></p>

      <% if (listing.amenities && listing.amenities.length > 0) { %>
        <h3>Amenities</h3>
        <div class="amenities-list">
          <% listing.amenities.forEach(function(amenity) { %>
            <span class="badge badge-amenity"><%= amenity %></span>
          <% }) %>
        </div>
      <% } %>

      <% if (listing.category) { %>
        <p style="margin-top: 16px; color: #666;"><strong>Category:</strong> <%= listing.category %></p>
      <% } %>

      <hr style="border: none; border-top: 1px solid #eee; margin: 20px 0;" />

      <p style="color: #666;">
        Hosted by <strong><%= listing.owner.username %></strong>
      </p>

      <%# ---------- Admin approval actions ---------- %>
      <% if (isAdmin && listing.status !== "approved") { %>
        <div class="admin-review-actions">
          <p style="margin: 0 0 12px 0; color: #666;">
            <strong>Admin review:</strong> This property is not yet approved.
          </p>
          <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <form action="/admin/listings/<%= listing._id %>/approve?_method=PUT" method="POST">
              <button type="submit" class="btn btn-primary">Approve</button>
            </form>
            <form action="/admin/listings/<%= listing._id %>/reject?_method=PUT" method="POST"
                  onsubmit="return confirm('Reject this property?');">
              <button type="submit" class="btn btn-danger">Reject</button>
            </form>
            <a href="/admin" class="btn btn-secondary">Back to dashboard</a>
          </div>
        </div>
      <% } %>

      <%# ---------- Owner/Admin edit actions ---------- %>
      <% if (isOwner || isAdmin) { %>
        <div style="display: flex; gap: 12px; margin-top: 16px; flex-wrap: wrap;">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-primary">Edit Property</a>
          <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" style="display: inline;"
                onsubmit="return confirm('Are you sure you want to delete this property?');">
            <button type="submit" class="btn btn-danger">Delete Property</button>
          </form>
        </div>
      <% } %>
    </div>

  </div>

  <a href="/listings" style="display: inline-block; margin-top: 24px; color: var(--terracotta); font-weight: 600;">
    ← Back to all listings
  </a>
</section>
