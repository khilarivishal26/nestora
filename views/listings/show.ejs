<% layout("layouts/boilerplate") %>

<section class="container" style="padding: 40px 24px;">
  <div class="show-page">

    <%# ========== IMAGE GALLERY ========== %>
    <div class="gallery">
      <% if (listing.images && listing.images.length > 0) { %>
        <div class="gallery-main">
          <img src="<%= listing.images[0] %>" alt="<%= listing.title %>" id="gallery-main-img" />
        </div>
        <% if (listing.images.length > 1) { %>
          <div class="gallery-thumbs">
            <% listing.images.forEach(function(img, i) { %>
              <img src="<%= img %>" alt="<%= listing.title %> — Image <%= i + 1 %>"
                   class="gallery-thumb <%= i === 0 ? 'active' : '' %>"
                   onclick="document.getElementById('gallery-main-img').src=this.src; document.querySelectorAll('.gallery-thumb').forEach(t=>t.classList.remove('active')); this.classList.add('active');" />
            <% }) %>
          </div>
        <% } %>
      <% } else { %>
        <div class="listing-image-placeholder">
          <p>No images uploaded</p>
        </div>
      <% } %>
    </div>

    <%# ========== MAIN CONTENT + BOOKING SIDEBAR ========== %>
    <div class="show-content">

      <%# ---------- Left Column: Property Details ---------- %>
      <div class="show-details">

        <% const isFav = (typeof wishlistListingIds !== 'undefined' && Array.isArray(wishlistListingIds) && wishlistListingIds.includes(listing._id.toString())); %>
        <%# -- Header -- %>
        <div class="show-header">
          <div>
            <h1 style="color: var(--forest-green); margin: 0 0 6px 0; font-size: 2rem;"><%= listing.title %></h1>
            <p style="color: #666; margin: 0; font-size: 1.05rem;">📍 <%= listing.location %>, <%= listing.country %></p>
          </div>
          <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 10px;">
            <% if (reviewCount > 0) { %>
              <div style="display: flex; align-items: center; gap: 6px; justify-content: flex-end;">
                <span style="font-size: 1.25rem; font-weight: 700; color: var(--forest-green);">
                  ⭐ <%= avgRating %>
                </span>
                <span style="color: #666; font-size: 0.95rem;">
                  (<%= reviewCount %> review<%= reviewCount !== 1 ? 's' : '' %>)
                </span>
              </div>
            <% } else { %>
              <span style="color: #888; font-size: 0.95rem;">⭐ New (No reviews yet)</span>
            <% } %>

            <%# Wishlist Action Button %>
            <button type="button"
                    class="btn-wishlist-detail <%= isFav ? 'active' : '' %>"
                    data-listing-id="<%= listing._id %>"
                    aria-label="<%= isFav ? 'Remove from wishlist' : 'Save to wishlist' %>"
                    title="<%= isFav ? 'Remove from wishlist' : 'Save to wishlist' %>"
                    onclick="toggleWishlist(event, '<%= listing._id %>')">
              <span class="wishlist-icon">♥</span>
              <span class="wishlist-label"><%= isFav ? 'Saved in Wishlist' : 'Save to Wishlist' %></span>
            </button>
          </div>
        </div>

        <%# Status badge (visible to owner/admin for non-approved) %>
        <% if (listing.status !== "approved") { %>
          <div style="margin-top: 14px;">
            <span class="badge badge-status badge-<%= listing.status %>"><%= listing.status.toUpperCase() %></span>
          </div>
        <% } %>

        <hr style="border: none; border-top: 1px solid #eee; margin: 24px 0;" />

        <%# -- Property Meta Badges -- %>
        <div class="listing-meta">
          <span class="badge badge-type" style="text-transform: capitalize;"><%= listing.propertyType %></span>
          <span>👥 <%= listing.maxGuests %> guest<%= listing.maxGuests !== 1 ? "s" : "" %> max</span>
          <span>🛏️ <%= listing.bedrooms %> bedroom<%= listing.bedrooms !== 1 ? "s" : "" %></span>
          <span>🛁 <%= listing.bathrooms %> bathroom<%= listing.bathrooms !== 1 ? "s" : "" %></span>
          <% if (listing.category) { %>
            <span class="badge badge-amenity">🏷️ <%= listing.category %></span>
          <% } %>
        </div>

        <%# -- Host Information Card -- %>
        <div class="host-info card" style="margin-top: 24px;">
          <div style="display: flex; align-items: center; gap: 16px;">
            <div class="host-avatar"><%= listing.owner.username.charAt(0).toUpperCase() %></div>
            <div>
              <p style="margin: 0; font-weight: 600; font-size: 1.05rem; color: var(--forest-green);">
                Hosted by <%= listing.owner.username %>
              </p>
              <p style="margin: 3px 0 0 0; color: #666; font-size: 0.9rem;">
                Member since <%= listing.owner.createdAt ? listing.owner.createdAt.toDateString() : 'Nestora Host' %>
              </p>
            </div>
          </div>
        </div>

        <%# -- Description -- %>
        <h3 style="margin-top: 32px; color: var(--forest-green);">About this stay</h3>
        <p style="line-height: 1.8; color: #333; font-size: 1rem; white-space: pre-line;"><%= listing.description %></p>

        <%# -- Amenities -- %>
        <% if (listing.amenities && listing.amenities.length > 0) { %>
          <h3 style="margin-top: 32px; color: var(--forest-green);">What this place offers</h3>
          <div class="amenities-list">
            <% listing.amenities.forEach(function(amenity) { %>
              <span class="badge badge-amenity">✓ <%= amenity %></span>
            <% }) %>
          </div>
        <% } %>

        <%# ========== INTERACTIVE MAP (Mapbox GL JS) ========== %>
        <h3 style="margin-top: 36px; color: var(--forest-green);">Where you'll be</h3>
        <p style="color: #666; margin: 4px 0 16px 0;">📍 <%= listing.location %>, <%= listing.country %></p>

        <% if (mapboxAccessToken || mapboxToken) { %>
          <link href="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css" rel="stylesheet" />
          <script src="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js"></script>

          <div id="property-map" class="show-map map-container"></div>

          <script>
            (function() {
              const mapboxToken = <%- JSON.stringify(mapboxAccessToken || mapboxToken || '') %>;
              const mapContainer = document.getElementById('property-map');
              if (!mapContainer) return;

              if (!mapboxToken || !mapboxToken.trim()) {
                mapContainer.outerHTML = `
                  <div class="map-fallback-card">
                    <p style="margin: 0; font-size: 1.05rem; font-weight: 600; color: var(--forest-green);">📍 <%= listing.location %>, <%= listing.country %></p>
                    <p style="margin: 6px 0 0 0; font-size: 0.88rem; color: #777;">Map is currently unavailable.</p>
                  </div>
                `;
                return;
              }

              const hasDirectCoords = <%= Boolean(listing.coordinates && typeof listing.coordinates.lat === 'number' && typeof listing.coordinates.lng === 'number' && (listing.coordinates.lat !== 0 || listing.coordinates.lng !== 0)) %>;
              const directLat = <%= (listing.coordinates && listing.coordinates.lat) || 0 %>;
              const directLng = <%= (listing.coordinates && listing.coordinates.lng) || 0 %>;
              const locationName = <%- JSON.stringify(listing.location || '') %>;
              const countryName = <%- JSON.stringify(listing.country || '') %>;
              const listingTitle = <%- JSON.stringify(listing.title || '') %>;

              function showLocationFallback() {
                mapContainer.outerHTML = `
                  <div class="map-fallback-card">
                    <p style="margin: 0; font-size: 1.05rem; font-weight: 600; color: var(--forest-green);">📍 ${locationName}, ${countryName}</p>
                    <p style="margin: 6px 0 0 0; font-size: 0.88rem; color: #777;">Location map unavailable.</p>
                  </div>
                `;
              }

              function initializeMap(lng, lat) {
                if (typeof lng !== 'number' || typeof lat !== 'number' || isNaN(lng) || isNaN(lat)) {
                  showLocationFallback();
                  return;
                }

                try {
                  mapboxgl.accessToken = mapboxToken;

                  const map = new mapboxgl.Map({
                    container: 'property-map',
                    style: 'mapbox://styles/mapbox/streets-v12',
                    center: [lng, lat],
                    zoom: 13,
                  });

                  map.addControl(new mapboxgl.NavigationControl());

                  // Create Popup
                  const popup = new mapboxgl.Popup({ offset: 25 }).setHTML(`
                    <div style="font-family: inherit; padding: 4px 2px;">
                      <strong style="color: #174a3a; font-size: 0.95rem; display: block;">${listingTitle}</strong>
                      <span style="color: #666; font-size: 0.85rem;">${locationName}, ${countryName}</span>
                    </div>
                  `);

                  // Create Nestora Marker at [longitude, latitude]
                  new mapboxgl.Marker({ color: '#174a3a' })
                    .setLngLat([lng, lat])
                    .setPopup(popup)
                    .addTo(map);
                } catch (err) {
                  console.warn('Mapbox initialization error:', err);
                  showLocationFallback();
                }
              }

              if (hasDirectCoords) {
                initializeMap(directLng, directLat);
              } else if (locationName || countryName) {
                // Forward geocode with Mapbox Geocoding API if coordinates not directly stored
                const query = encodeURIComponent(`${locationName}, ${countryName}`.trim());
                fetch(`https://api.mapbox.com/geocoding/v5/mapbox.places/${query}.json?access_token=${mapboxToken}&limit=1`)
                  .then(res => res.json())
                  .then(data => {
                    if (data && data.features && data.features.length > 0 && data.features[0].center) {
                      const [lng, lat] = data.features[0].center;
                      initializeMap(lng, lat);
                    } else {
                      showLocationFallback();
                    }
                  })
                  .catch(() => {
                    showLocationFallback();
                  });
              } else {
                showLocationFallback();
              }
            })();
          </script>
        <% } else { %>
          <div class="map-fallback-card">
            <p style="margin: 0; font-size: 1.05rem; font-weight: 600; color: var(--forest-green);">📍 <%= listing.location %>, <%= listing.country %></p>
            <p style="margin: 6px 0 0 0; font-size: 0.88rem; color: #777;">Map is currently unavailable.</p>
          </div>
        <% } %>

        <%# ========== ADMIN ACTIONS ========== %>
        <% if (isAdmin && listing.status !== "approved") { %>
          <div class="admin-review-actions" style="margin-top: 28px;">
            <p style="margin: 0 0 12px 0; color: #666; font-size: 0.95rem;">
              <strong>Admin Review:</strong> This property is currently <strong><%= listing.status %></strong>.
            </p>
            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
              <form action="/admin/listings/<%= listing._id %>/approve?_method=PUT" method="POST">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                <button type="submit" class="btn btn-primary">Approve Property</button>
              </form>
              <form action="/admin/listings/<%= listing._id %>/reject?_method=PUT" method="POST"
                    onsubmit="return confirm('Reject this property?');">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                <button type="submit" class="btn btn-danger">Reject Property</button>
              </form>
              <a href="/admin" class="btn btn-secondary">Admin Dashboard</a>
            </div>
          </div>
        <% } %>

        <%# ========== OWNER ACTIONS ========== %>
        <% if (isOwner || isAdmin) { %>
          <div style="display: flex; gap: 12px; margin-top: 24px; flex-wrap: wrap;">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-primary">Edit Property</a>
            <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" style="display: inline;"
                  onsubmit="return confirm('Are you sure you want to delete this property? This cannot be undone.');">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
              <button type="submit" class="btn btn-danger">Delete Property</button>
            </form>
          </div>
        <% } %>

        <%# ========== REVIEWS SECTION ========== %>
        <div class="reviews-section" style="margin-top: 48px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
            <h2 style="color: var(--forest-green); margin: 0;">
              <% if (reviewCount > 0) { %>
                ⭐ <%= avgRating %> · <%= reviewCount %> Guest Review<%= reviewCount !== 1 ? 's' : '' %>
              <% } else { %>
                Guest Reviews
              <% } %>
            </h2>
          </div>

          <%# -- Review submission form (Verified stay guests only) -- %>
          <% if (typeof currentUser !== "undefined" && currentUser && listing.status === "approved") { %>
            <% if (typeof isEligibleGuest !== "undefined" && isEligibleGuest && !hasReviewed) { %>
              <div class="card review-form-card">
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
                  <span style="font-size: 1.2rem;">✨</span>
                  <h3 style="margin: 0; color: var(--forest-green);">Share Your Stay Experience</h3>
                </div>
                <p style="color: #666; font-size: 0.9rem; margin: 0 0 16px 0;">
                  As a verified guest, your review helps future travelers and hosts on Nestora.
                </p>
                <form action="/listings/<%= listing._id %>/reviews" method="POST">
                  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                  <div class="form-group">
                    <label for="rating">Rating <span class="required">*</span></label>
                    <select name="rating" id="rating" required>
                      <option value="">Select your rating…</option>
                      <option value="5">⭐⭐⭐⭐⭐ 5 Stars — Exceptional</option>
                      <option value="4">⭐⭐⭐⭐ 4 Stars — Very Good</option>
                      <option value="3">⭐⭐⭐ 3 Stars — Average</option>
                      <option value="2">⭐⭐ 2 Stars — Below Expectations</option>
                      <option value="1">⭐ 1 Star — Poor</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label for="body">Your Review <span class="required">*</span></label>
                    <textarea name="body" id="body" rows="4" placeholder="Describe the place, hospitality, cleanliness, and neighborhood…" required></textarea>
                  </div>
                  <button type="submit" class="btn btn-primary">Submit Review</button>
                </form>
              </div>
            <% } else if (hasReviewed) { %>
              <div class="card" style="padding: 18px 24px; margin-bottom: 24px; background: #eaf4ef; border: 1px solid #c8e2d4;">
                <p style="margin: 0; color: #155724; font-weight: 500;">
                  ✅ You have submitted a review for this stay. Thank you for your feedback!
                </p>
              </div>
            <% } else if (isOwner) { %>
              <div class="card" style="padding: 16px 20px; margin-bottom: 24px; background: #fdfaf6; border: 1px solid #ebd9c8;">
                <p style="margin: 0; color: #886047; font-size: 0.95rem;">
                  ℹ️ You are the host of this property.
                </p>
              </div>
            <% } else { %>
              <div class="card" style="padding: 18px 24px; margin-bottom: 24px; background: #fdfaf6; border: 1px solid #eee5da;">
                <p style="margin: 0; color: #666; font-size: 0.95rem;">
                  🔒 <strong>Verified Guest Reviews:</strong> Only guests with a confirmed reservation for this property can submit a review.
                </p>
              </div>
            <% } %>
          <% } else if (!currentUser && listing.status === "approved") { %>
            <div class="card" style="padding: 20px; text-align: center; margin-bottom: 24px;">
              <p style="margin: 0; color: #666;">
                <a href="/login" style="color: var(--terracotta); font-weight: 600;">Log in</a> to view review eligibility.
              </p>
            </div>
          <% } %>

          <%# -- Review list -- %>
          <% if (listing.reviews && listing.reviews.length > 0) { %>
            <div class="reviews-list">
              <% listing.reviews.forEach(function(review) { %>
                <div class="card review-card">
                  <div class="review-header">
                    <div>
                      <strong style="color: var(--forest-green); font-size: 1rem;"><%= review.author.username %></strong>
                      <span style="color: #888; font-size: 0.85rem; margin-left: 10px;">
                        <%= review.createdAt ? review.createdAt.toDateString() : '' %>
                      </span>
                    </div>
                    <span class="review-stars">
                      <% for (let i = 0; i < review.rating; i++) { %>⭐<% } %>
                    </span>
                  </div>
                  <p class="review-body"><%= review.body %></p>
                  <% if (currentUser && (review.author._id.equals(currentUser._id) || currentUser.role === "admin")) { %>
                    <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                          method="POST" style="margin-top: 10px;"
                          onsubmit="return confirm('Delete this review?');">
                      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                      <button type="submit" class="btn btn-danger" style="padding: 4px 12px; font-size: 0.8rem;">
                        Delete
                      </button>
                    </form>
                  <% } %>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="card" style="padding: 32px 24px; text-align: center;">
              <p style="color: #666; margin: 0; font-size: 1rem;">No reviews yet. Be the first to share your experience!</p>
            </div>
          <% } %>
        </div>

      </div>

      <%# ---------- Right Column: Booking Widget Sidebar ---------- %>
      <div class="show-sidebar">
        <div class="card booking-card">

          <%# Price Header %>
          <div class="booking-price-header">
            <div style="display: flex; align-items: baseline; gap: 4px;">
              <span class="booking-price-amount">₹<%= listing.price.toLocaleString() %></span>
              <span class="booking-price-period">/ night</span>
            </div>
            <% if (reviewCount > 0) { %>
              <div class="booking-rating-badge" style="font-size: 0.95rem; font-weight: 700; color: var(--forest-green);">
                ⭐ <%= avgRating %> <span style="font-weight: normal; color: #777;">(<%= reviewCount %>)</span>
              </div>
            <% } else { %>
              <div style="font-size: 0.85rem; color: #777; font-weight: 500;">
                ✨ New stay
              </div>
            <% } %>
          </div>

          <hr style="border: none; border-top: 1px solid #eee5da; margin: 16px 0;" />

          <%# Booking Form & Calculations %>
          <form id="booking-form" action="/listings/<%= listing._id %>/bookings" method="POST">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />

            <%# Dates Section %>
            <div class="booking-date-inputs">
              <div class="booking-date-field">
                <label for="checkIn">CHECK-IN</label>
                <input type="date" id="checkIn" name="checkIn" required />
              </div>
              <div class="booking-date-field">
                <label for="checkOut">CHECK-OUT</label>
                <input type="date" id="checkOut" name="checkOut" required />
              </div>
            </div>

            <%# Guests Section %>
            <div class="booking-guest-field">
              <label for="bookingGuests">GUESTS</label>
              <select id="bookingGuests" name="guests" required>
                <% for (let i = 1; i <= listing.maxGuests; i++) { %>
                  <option value="<%= i %>"><%= i %> guest<%= i !== 1 ? 's' : '' %></option>
                <% } %>
              </select>
            </div>

            <%# Dynamic Price Calculation Summary %>
            <div id="booking-breakdown" class="booking-breakdown" style="display: none;">
              <div class="booking-breakdown-row">
                <span id="price-calc-label">₹<%= listing.price.toLocaleString() %> × 1 night</span>
                <span id="price-calc-subtotal" style="font-weight: 600; color: var(--charcoal);">₹<%= listing.price.toLocaleString() %></span>
              </div>
              <hr style="border: none; border-top: 1px dashed #dcd3c3; margin: 12px 0;" />
              <div class="booking-breakdown-row total">
                <strong>Total</strong>
                <strong id="price-calc-total" style="color: var(--forest-green); font-size: 1.3rem;">₹0</strong>
              </div>
            </div>

            <%# Reserve Button %>
            <div style="margin-top: 20px;">
              <% if (!currentUser && listing.status === "approved") { %>
                <a href="/login" class="btn btn-primary btn-reserve" style="display: block; text-align: center; width: 100%; padding: 14px; font-size: 1.05rem; font-weight: 700; border-radius: 12px;">
                  Log In to Reserve
                </a>
                <p style="text-align: center; color: #777; font-size: 0.82rem; margin: 10px 0 0 0;">
                  You won't be charged yet
                </p>
              <% } else if (listing.status === "approved" && !isOwner) { %>
                <button type="submit" id="btn-reserve-submit" class="btn btn-primary btn-reserve" style="width: 100%; padding: 14px; font-size: 1.05rem; font-weight: 700; border-radius: 12px;">
                  Reserve Stay
                </button>
                <p style="text-align: center; color: #777; font-size: 0.82rem; margin: 10px 0 0 0;">
                  Instant confirmation · No extra guest fee
                </p>
              <% } else if (isOwner) { %>
                <button type="button" disabled class="btn btn-secondary btn-reserve" style="width: 100%; padding: 14px; opacity: 0.7; cursor: not-allowed; border-radius: 12px;">
                  Your Property
                </button>
                <p style="text-align: center; color: #777; font-size: 0.82rem; margin: 8px 0 0 0;">
                  Hosts cannot reserve their own property
                </p>
              <% } else { %>
                <button type="button" disabled class="btn btn-secondary btn-reserve" style="width: 100%; padding: 14px; opacity: 0.7; cursor: not-allowed; border-radius: 12px;">
                  Not Available
                </button>
                <p style="text-align: center; color: #888; font-size: 0.82rem; margin: 8px 0 0 0;">
                  Awaiting approval before booking
                </p>
              <% } %>
            </div>
          </form>

          <hr style="border: none; border-top: 1px solid #eee5da; margin: 20px 0;" />

          <%# Property Information Section %>
          <div class="booking-info-list">
            <div class="booking-info-row">
              <span>👥 Max capacity</span>
              <strong><%= listing.maxGuests %> guest<%= listing.maxGuests !== 1 ? 's' : '' %></strong>
            </div>
            <div class="booking-info-row">
              <span>🛏 Bedrooms</span>
              <strong><%= listing.bedrooms %></strong>
            </div>
            <div class="booking-info-row">
              <span>🛁 Bathrooms</span>
              <strong><%= listing.bathrooms %></strong>
            </div>
            <div class="booking-info-row">
              <span>🏠 Property type</span>
              <strong style="text-transform: capitalize;"><%= listing.propertyType %></strong>
            </div>
          </div>

        </div>
      </div>

    </div>

    <%# Back to listings link %>
    <a href="/listings" style="display: inline-block; margin-top: 36px; color: var(--terracotta); font-weight: 600; font-size: 1rem;">
      ← Back to all stays
    </a>

  </div>
</section>

<%# ========== CLIENT SCRIPTS FOR DATES & CALCULATION ========== %>
<script>
  (function() {
    const pricePerNight = <%= listing.price %>;
    const checkInInput = document.getElementById("checkIn");
    const checkOutInput = document.getElementById("checkOut");
    const breakdownEl = document.getElementById("booking-breakdown");
    const calcLabel = document.getElementById("price-calc-label");
    const calcSubtotal = document.getElementById("price-calc-subtotal");
    const calcTotal = document.getElementById("price-calc-total");
    const bookingForm = document.getElementById("booking-form");
    const submitBtn = document.getElementById("btn-reserve-submit");

    if (!checkInInput || !checkOutInput) return;

    // Set default dates: check-in = tomorrow, check-out = 3 days later
    const today = new Date();
    const tomorrow = new Date(today);
    tomorrow.setDate(today.getDate() + 1);

    const checkOutDate = new Date(tomorrow);
    checkOutDate.setDate(tomorrow.getDate() + 2);

    const formatDate = (d) => d.toISOString().split("T")[0];

    checkInInput.min = formatDate(today);
    checkInInput.value = formatDate(tomorrow);

    checkOutInput.min = formatDate(tomorrow);
    checkOutInput.value = formatDate(checkOutDate);

    function updatePricing() {
      const start = new Date(checkInInput.value);
      const end = new Date(checkOutInput.value);

      if (start && end && end > start) {
        const diffTime = Math.abs(end - start);
        const nights = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

        if (nights > 0) {
          const total = pricePerNight * nights; // Guest pays nightly rate × nights

          calcLabel.textContent = `₹${pricePerNight.toLocaleString()} × ${nights} night${nights > 1 ? 's' : ''}`;
          calcSubtotal.textContent = `₹${total.toLocaleString()}`;
          calcTotal.textContent = `₹${total.toLocaleString()}`;
          breakdownEl.style.display = "block";
        } else {
          breakdownEl.style.display = "none";
        }
      } else {
        breakdownEl.style.display = "none";
      }
    }

    checkInInput.addEventListener("change", function() {
      const start = new Date(this.value);
      const nextDay = new Date(start);
      nextDay.setDate(start.getDate() + 1);
      checkOutInput.min = formatDate(nextDay);

      if (new Date(checkOutInput.value) <= start) {
        checkOutInput.value = formatDate(nextDay);
      }
      updatePricing();
    });

    checkOutInput.addEventListener("change", updatePricing);
    updatePricing();

    // Prevent accidental double submissions
    if (bookingForm && submitBtn) {
      bookingForm.addEventListener("submit", function() {
        submitBtn.disabled = true;
        submitBtn.textContent = "Processing Reservation…";
        submitBtn.style.opacity = "0.75";
        submitBtn.style.cursor = "wait";
      });
    }
  })();
</script>
