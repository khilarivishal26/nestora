<% layout("layouts/boilerplate") %>

<% const listing = booking.listing; %>

<section class="container" style="padding: 40px 24px;">
  <div style="max-width: 780px; margin: 0 auto;">

    <%# Success / Header Banner %>
    <div style="margin-bottom: 24px;">
      <a href="/bookings/my" style="color: var(--terracotta); font-weight: 600; font-size: 0.95rem; text-decoration: none;">
        ← Back to My Reservations
      </a>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 16px; flex-wrap: wrap; gap: 12px;">
        <div>
          <h1 style="color: var(--forest-green); margin: 0 0 4px 0;">
            <% if (booking.status === "confirmed" && booking.paymentStatus === "paid") { %>
              🎉 Reservation Confirmed & Paid
            <% } else if (booking.status === "confirmed") { %>
              🎉 Reservation Confirmed
            <% } else if (booking.status === "cancelled") { %>
              Reservation Cancelled
            <% } else { %>
              Reservation <%= booking.status.toUpperCase() %>
            <% } %>
          </h1>
          <p style="color: #666; margin: 0;">
            Booking ID: <span style="font-family: monospace; font-weight: 600;"><%= booking._id %></span> · Booked on <%= booking.createdAt.toDateString() %>
          </p>
        </div>
        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
          <span class="badge badge-booking-status badge-<%= booking.status %>" style="font-size: 0.88rem; padding: 6px 12px;">
            <%= booking.status.toUpperCase() %>
          </span>
          <% if (booking.paymentStatus === "paid") { %>
            <span class="badge badge-booking-status badge-confirmed" style="font-size: 0.88rem; padding: 6px 12px;">
              💳 PAID
            </span>
          <% } else if (booking.paymentStatus === "failed") { %>
            <span class="badge badge-booking-status badge-cancelled" style="font-size: 0.88rem; padding: 6px 12px;">
              ⚠️ PAYMENT FAILED
            </span>
          <% } else { %>
            <span class="badge badge-booking-status badge-pending" style="font-size: 0.88rem; padding: 6px 12px;">
              ⏳ PAYMENT PENDING
            </span>
          <% } %>
        </div>
      </div>
    </div>

    <%# Payment Required Warning Alert %>
    <% if (booking.paymentStatus !== "paid" && booking.status !== "cancelled" && isGuest) { %>
      <div class="card" style="padding: 20px 24px; margin-bottom: 24px; background: #fff8eb; border: 1px solid #f6d8a7; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
          <h3 style="margin: 0 0 4px 0; color: #856404; font-size: 1.1rem;">Payment Required to Secure Stay</h3>
          <p style="margin: 0; color: #666; font-size: 0.9rem;">
            Please complete checkout with Razorpay to confirm your reservation and guarantee availability.
          </p>
        </div>
        <a href="/bookings/<%= booking._id %>/payment" class="btn btn-primary" style="padding: 10px 20px;">
          💳 Complete Payment (₹<%= booking.totalPrice.toLocaleString() %>)
        </a>
      </div>
    <% } %>

    <%# Main Confirmation Card %>
    <div class="card" style="padding: 32px; margin-bottom: 24px;">

      <%# Property Overview %>
      <% if (listing) { %>
        <div style="display: flex; gap: 20px; align-items: center; flex-wrap: wrap;">
          <div style="width: 140px; height: 95px; border-radius: 8px; overflow: hidden; flex-shrink: 0; background: #eee;">
            <% if (listing.images && listing.images.length > 0) { %>
              <img src="<%= listing.images[0] %>" alt="<%= listing.title %>" style="width: 100%; height: 100%; object-fit: cover;" />
            <% } else { %>
              <div class="listing-card-placeholder" style="height: 100%;">No Image</div>
            <% } %>
          </div>
          <div>
            <span class="badge badge-type" style="text-transform: capitalize; margin-bottom: 6px;"><%= listing.propertyType %></span>
            <h2 style="margin: 0 0 4px 0; font-size: 1.35rem;">
              <a href="/listings/<%= listing._id %>" style="color: var(--forest-green); text-decoration: none;">
                <%= listing.title %>
              </a>
            </h2>
            <p style="color: #666; margin: 0; font-size: 0.95rem;">📍 <%= listing.location %>, <%= listing.country %></p>
          </div>
        </div>

        <hr style="border: none; border-top: 1px solid #eee; margin: 24px 0;" />
      <% } %>

      <%# Dates & Guests %>
      <div class="booking-meta-grid" style="grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 16px;">
        <div class="card" style="padding: 16px; background: #fdfaf6; border: 1px solid #eee5da;">
          <span class="booking-meta-label">CHECK-IN</span>
          <strong style="display: block; font-size: 1rem; color: var(--forest-green); margin-top: 4px;">
            <%= booking.checkIn.toDateString() %>
          </strong>
          <span style="color: #888; font-size: 0.8rem;">After 2:00 PM</span>
        </div>

        <div class="card" style="padding: 16px; background: #fdfaf6; border: 1px solid #eee5da;">
          <span class="booking-meta-label">CHECKOUT</span>
          <strong style="display: block; font-size: 1rem; color: var(--forest-green); margin-top: 4px;">
            <%= booking.checkOut.toDateString() %>
          </strong>
          <span style="color: #888; font-size: 0.8rem;">Before 11:00 AM</span>
        </div>

        <div class="card" style="padding: 16px; background: #fdfaf6; border: 1px solid #eee5da;">
          <span class="booking-meta-label">DURATION</span>
          <strong style="display: block; font-size: 1rem; color: var(--forest-green); margin-top: 4px;">
            <%= booking.nights %> Night<%= booking.nights !== 1 ? 's' : '' %>
          </strong>
          <span style="color: #888; font-size: 0.8rem;"><%= booking.guests %> Guest<%= booking.guests !== 1 ? 's' : '' %></span>
        </div>
      </div>

      <hr style="border: none; border-top: 1px solid #eee; margin: 24px 0;" />

      <%# Price Breakdown %>
      <h3 style="color: var(--forest-green); margin: 0 0 16px 0;">Financial Breakdown</h3>
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <div style="display: flex; justify-content: space-between; color: #555; font-size: 0.95rem;">
          <span>₹<%= booking.pricePerNight.toLocaleString() %> × <%= booking.nights %> night<%= booking.nights !== 1 ? 's' : '' %></span>
          <span>₹<%= booking.totalPrice.toLocaleString() %></span>
        </div>
        <% if (typeof currentUser !== "undefined" && currentUser && (currentUser.role === "admin" || (booking.listing && booking.listing.owner && booking.listing.owner._id && booking.listing.owner._id.equals(currentUser._id)))) { %>
          <div style="display: flex; justify-content: space-between; color: #777; font-size: 0.9rem; padding: 4px 0;">
            <span>Nestora Commission (5%):</span>
            <span>₹<%= (booking.platformCommission || booking.serviceFee || Math.round(booking.totalPrice * 0.05)).toLocaleString() %></span>
          </div>
          <div style="display: flex; justify-content: space-between; color: var(--forest-green); font-size: 0.95rem; font-weight: 600; padding: 4px 0;">
            <span>Host Net Earnings:</span>
            <span>₹<%= (booking.hostEarnings || (booking.totalPrice - Math.round(booking.totalPrice * 0.05))).toLocaleString() %></span>
          </div>
        <% } %>
        <hr style="border: none; border-top: 1px solid #eee; margin: 8px 0;" />
        <div style="display: flex; justify-content: space-between; font-size: 1.2rem; color: var(--forest-green); font-weight: 700;">
          <span>Total Paid by Guest</span>
          <span>₹<%= booking.totalPrice.toLocaleString() %></span>
        </div>
      </div>

      <%# Payment Info Badge %>
      <div style="margin-top: 20px; padding: 14px 18px; background: #fdfaf6; border: 1px solid #eee5da; border-radius: 8px;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
          <div>
            <span style="font-size: 0.85rem; color: #666;">Payment Status:</span>
            <strong style="margin-left: 6px; text-transform: uppercase; color: <%= booking.paymentStatus === 'paid' ? '#155724' : '#856404' %>;">
              <%= booking.paymentStatus || 'pending' %>
            </strong>
          </div>
          <% if (booking.paidAt) { %>
            <span style="font-size: 0.85rem; color: #666;">Paid on: <strong><%= booking.paidAt.toDateString() %></strong></span>
          <% } %>
          <% if (booking.razorpayPaymentId || booking.stripePaymentIntentId) { %>
            <span style="font-size: 0.8rem; color: #888; font-family: monospace;">Ref: <%= booking.razorpayPaymentId || booking.stripePaymentIntentId %></span>
          <% } %>
        </div>
      </div>

      <hr style="border: none; border-top: 1px solid #eee; margin: 24px 0;" />

      <%# Host & Guest details %>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <div>
          <h4 style="margin: 0 0 6px 0; color: #555; font-size: 0.85rem; text-transform: uppercase;">Guest Info</h4>
          <p style="margin: 0; font-weight: 600;"><%= booking.guest ? booking.guest.username : 'N/A' %></p>
          <p style="margin: 2px 0 0 0; color: #666; font-size: 0.85rem;"><%= booking.guest ? booking.guest.email : '' %></p>
        </div>

        <% if (listing && listing.owner) { %>
          <div>
            <h4 style="margin: 0 0 6px 0; color: #555; font-size: 0.85rem; text-transform: uppercase;">Host Info</h4>
            <p style="margin: 0; font-weight: 600;"><%= listing.owner.username %></p>
            <p style="margin: 2px 0 0 0; color: #666; font-size: 0.85rem;"><%= listing.owner.email %></p>
          </div>
        <% } %>
      </div>

      <%# Cancel Action %>
      <% if (booking.status !== "cancelled") { %>
        <div style="margin-top: 32px; padding-top: 20px; border-top: 1px solid #eee; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
          <div>
            <strong style="color: #333;">Need to change your plans?</strong>
            <p style="margin: 2px 0 0 0; color: #666; font-size: 0.85rem;">You can cancel this booking at any time.</p>
          </div>
          <form action="/bookings/<%= booking._id %>/cancel?_method=PUT" method="POST"
                onsubmit="return confirm('Are you sure you want to cancel this reservation? This cannot be undone.');">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
            <button type="submit" class="btn btn-danger" style="padding: 10px 20px;">
              Cancel Reservation
            </button>
          </form>
        </div>
      <% } %>

    </div>

  </div>
</section>
