<% layout("layouts/boilerplate") %>

<section class="container" style="padding: 40px 24px;">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 28px;">
    <div>
      <h1 style="color: var(--forest-green); margin: 0 0 6px 0;">My Reservations</h1>
      <p style="color: #666; margin: 0;">Manage your upcoming and past stays on Nestora.</p>
    </div>
    <a href="/listings" class="btn btn-primary">Explore More Stays</a>
  </div>

  <% if (bookings.length === 0) { %>
    <div class="card" style="text-align: center; padding: 56px 24px;">
      <h2 style="color: var(--forest-green); margin-top: 0;">No reservations yet</h2>
      <p style="color: #666; max-width: 460px; margin: 8px auto 24px auto;">
        You haven't booked any stays yet. Explore unique cottages, villas, hotels, and resorts worldwide!
      </p>
      <a href="/listings" class="btn btn-primary">Start Exploring</a>
    </div>
  <% } else { %>
    <div class="booking-grid">
      <% bookings.forEach(function(booking) { %>
        <% const listing = booking.listing; %>
        <div class="card booking-list-card">
          <div class="booking-card-media">
            <% if (listing && listing.images && listing.images.length > 0) { %>
              <img src="<%= listing.images[0] %>" alt="<%= listing.title %>" />
            <% } else { %>
              <div class="listing-card-placeholder">No Image</div>
            <% } %>
          </div>

          <div class="booking-card-details">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
              <div>
                <h3 style="margin: 0 0 4px 0;">
                  <% if (listing) { %>
                    <a href="/listings/<%= listing._id %>" style="color: var(--forest-green); text-decoration: none;">
                      <%= listing.title %>
                    </a>
                  <% } else { %>
                    <span style="color: #666;">Property unavailable</span>
                  <% } %>
                </h3>
                <% if (listing) { %>
                  <p style="color: #666; margin: 0; font-size: 0.9rem;">📍 <%= listing.location %>, <%= listing.country %></p>
                <% } %>
              </div>
              <span class="badge badge-booking-status badge-<%= booking.status %>">
                <%= booking.status.toUpperCase() %>
              </span>
            </div>

            <hr style="border: none; border-top: 1px solid #eee; margin: 12px 0;" />

            <div class="booking-meta-grid">
              <div>
                <span class="booking-meta-label">CHECK-IN</span>
                <span class="booking-meta-value"><%= booking.checkIn.toDateString() %></span>
              </div>
              <div>
                <span class="booking-meta-label">CHECKOUT</span>
                <span class="booking-meta-value"><%= booking.checkOut.toDateString() %></span>
              </div>
              <div>
                <span class="booking-meta-label">DETAILS</span>
                <span class="booking-meta-value">
                  <%= booking.nights %> night<%= booking.nights !== 1 ? 's' : '' %> · <%= booking.guests %> guest<%= booking.guests !== 1 ? 's' : '' %>
                </span>
              </div>
              <div>
                <span class="booking-meta-label">TOTAL PAID</span>
                <span class="booking-meta-value" style="font-weight: 700; color: var(--forest-green);">
                  ₹<%= booking.totalPrice.toLocaleString() %>
                </span>
              </div>
            </div>

            <div class="booking-card-actions" style="margin-top: 16px;">
              <a href="/bookings/<%= booking._id %>" class="btn btn-secondary" style="padding: 8px 16px; font-size: 0.9rem;">
                View Details
              </a>
              <% if (booking.paymentStatus !== "paid" && booking.status !== "cancelled") { %>
                <a href="/bookings/<%= booking._id %>/payment" class="btn btn-primary" style="padding: 8px 16px; font-size: 0.9rem;">
                  💳 Complete Payment
                </a>
              <% } %>
              <% if (booking.status !== "cancelled") { %>
                <form action="/bookings/<%= booking._id %>/cancel?_method=PUT" method="POST" style="display: inline;"
                      onsubmit="return confirm('Are you sure you want to cancel this reservation?');">
                  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
                  <button type="submit" class="btn btn-danger" style="padding: 8px 16px; font-size: 0.9rem;">
                    Cancel Stay
                  </button>
                </form>
              <% } %>
            </div>

          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</section>
