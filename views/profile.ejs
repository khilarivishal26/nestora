<% layout("layouts/boilerplate") %>

<section class="container" style="padding: 40px 24px;">

  <%# Profile Header Card %>
  <div class="card" style="padding: 28px; margin-bottom: 32px;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;">
      <div style="display: flex; align-items: center; gap: 18px;">
        <div class="host-avatar" style="width: 64px; height: 64px; font-size: 1.8rem;">
          <%= currentUser.username.charAt(0).toUpperCase() %>
        </div>
        <div>
          <div style="display: flex; align-items: center; gap: 10px;">
            <h1 style="color: var(--forest-green); margin: 0; font-size: 1.8rem;"><%= currentUser.username %></h1>
            <span class="badge <%= currentUser.role === 'admin' ? 'badge-type' : currentUser.role === 'host' ? 'badge-amenity' : 'badge-status badge-approved' %>" style="text-transform: uppercase;">
              <%= currentUser.role %>
            </span>
          </div>
          <p style="color: #666; margin: 4px 0 0 0; font-size: 0.95rem;">
            📧 <%= currentUser.email %> · Member since <%= currentUser.createdAt.toDateString() %>
          </p>
        </div>
      </div>

      <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <a href="/listings" class="btn btn-primary">Explore Stays</a>
        <% if (currentUser.role === "host" || currentUser.role === "admin") { %>
          <a href="/host/dashboard" class="btn btn-secondary">Host Dashboard</a>
        <% } %>
        <% if (currentUser.role === "admin") { %>
          <a href="/admin" class="btn btn-secondary">Admin Dashboard</a>
        <% } %>
      </div>
    </div>
  </div>

  <%# Guest Travel Summary Stats %>
  <div class="dashboard-stats-grid" style="margin-bottom: 32px;">
    <div class="card dashboard-stat-card">
      <span class="dashboard-stat-label">UPCOMING TRIPS</span>
      <span class="dashboard-stat-value" style="color: var(--forest-green);"><%= upcomingBookings.length %></span>
      <span class="dashboard-stat-sub">Confirmed future stays</span>
    </div>

    <div class="card dashboard-stat-card">
      <span class="dashboard-stat-label">COMPLETED STAYS</span>
      <span class="dashboard-stat-value"><%= pastBookings.length %></span>
      <span class="dashboard-stat-sub">Past Nestora getaways</span>
    </div>

    <div class="card dashboard-stat-card">
      <span class="dashboard-stat-label">TRAVEL SPEND</span>
      <span class="dashboard-stat-value" style="color: var(--terracotta);">₹<%= totalSpent.toLocaleString() %></span>
      <span class="dashboard-stat-sub">Across <%= totalTrips %> trip<%= totalTrips !== 1 ? 's' : '' %></span>
    </div>

    <div class="card dashboard-stat-card">
      <span class="dashboard-stat-label">CANCELLED</span>
      <span class="dashboard-stat-value"><%= cancelledBookings.length %></span>
      <span class="dashboard-stat-sub">Cancelled reservations</span>
    </div>
  </div>

  <%# Host Onboarding Conversion Banner (for Guests) %>
  <% if (currentUser.role === "guest") { %>
    <div class="card" style="padding: 24px; margin-bottom: 32px; background: linear-gradient(135deg, #eaf4ef 0%, #f7f2e8 100%); border: 1px solid #c9e2d5;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
          <h3 style="color: var(--forest-green); margin: 0 0 4px 0; font-size: 1.25rem;">Earn by hosting on Nestora</h3>
          <p style="color: #555; margin: 0; font-size: 0.95rem;">
            List your cottage, villa, apartment, or hotel room and welcome guests from around the world.
          </p>
        </div>
        <form action="/become-host" method="POST" style="margin: 0;">
          <button type="submit" class="btn btn-primary">Become a Host</button>
        </form>
      </div>
    </div>
  <% } %>

  <%# ========== UPCOMING TRIPS SECTION ========== %>
  <div class="card" style="padding: 28px; margin-bottom: 32px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
      <div>
        <h2 style="color: var(--forest-green); margin: 0 0 4px 0;">Upcoming Reservations (<%= upcomingBookings.length %>)</h2>
        <p style="color: #666; margin: 0; font-size: 0.95rem;">Your confirmed stays ready for check-in.</p>
      </div>
      <a href="/bookings/my" class="btn btn-secondary">All Reservations</a>
    </div>

    <% if (upcomingBookings.length === 0) { %>
      <div style="text-align: center; padding: 36px 20px; background: #fdfaf6; border-radius: var(--radius);">
        <p style="color: #666; font-size: 1rem; margin: 0 0 12px 0;">No upcoming trips booked right now.</p>
        <a href="/listings" class="btn btn-primary">Explore Available Stays</a>
      </div>
    <% } else { %>
      <div class="booking-grid">
        <% upcomingBookings.forEach(function(booking) { %>
          <% const listing = booking.listing; %>
          <div class="card booking-list-card">
            <div class="booking-card-media">
              <% if (listing && listing.images && listing.images.length > 0) { %>
                <img src="<%= listing.images[0] %>" alt="<%= listing.title %>" />
              <% } else { %>
                <div class="listing-card-placeholder">No Image</div>
              <% } %>
            </div>

            <div class="booking-card-details">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                <div>
                  <h3 style="margin: 0 0 4px 0;">
                    <% if (listing) { %>
                      <a href="/listings/<%= listing._id %>" style="color: var(--forest-green); text-decoration: none;">
                        <%= listing.title %>
                      </a>
                    <% } else { %>
                      Deleted Property
                    <% } %>
                  </h3>
                  <% if (listing) { %>
                    <p style="color: #666; margin: 0; font-size: 0.9rem;">📍 <%= listing.location %>, <%= listing.country %></p>
                  <% } %>
                </div>
                <span class="badge badge-booking-status badge-<%= booking.status %>">
                  <%= booking.status.toUpperCase() %>
                </span>
              </div>

              <hr style="border: none; border-top: 1px solid #eee; margin: 12px 0;" />

              <div class="booking-meta-grid">
                <div>
                  <span class="booking-meta-label">CHECK-IN</span>
                  <span class="booking-meta-value"><%= booking.checkIn.toDateString() %></span>
                </div>
                <div>
                  <span class="booking-meta-label">CHECKOUT</span>
                  <span class="booking-meta-value"><%= booking.checkOut.toDateString() %></span>
                </div>
                <div>
                  <span class="booking-meta-label">STAY</span>
                  <span class="booking-meta-value"><%= booking.nights %> nights · <%= booking.guests %> guests</span>
                </div>
                <div>
                  <span class="booking-meta-label">TOTAL</span>
                  <span class="booking-meta-value" style="font-weight: 700; color: var(--forest-green);">
                    ₹<%= booking.totalPrice.toLocaleString() %>
                  </span>
                </div>
              </div>

              <div class="booking-card-actions" style="margin-top: 16px;">
                <a href="/bookings/<%= booking._id %>" class="btn btn-secondary" style="padding: 6px 14px; font-size: 0.88rem;">
                  View Receipt
                </a>
                <form action="/bookings/<%= booking._id %>/cancel?_method=PUT" method="POST" style="display: inline;"
                      onsubmit="return confirm('Cancel this upcoming reservation?');">
                  <button type="submit" class="btn btn-danger" style="padding: 6px 14px; font-size: 0.88rem;">
                    Cancel Stay
                  </button>
                </form>
              </div>

            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <%# ========== PAST & COMPLETED STAYS ========== %>
  <% if (pastBookings.length > 0) { %>
    <div class="card" style="padding: 28px; margin-bottom: 32px;">
      <h2 style="color: var(--forest-green); margin: 0 0 16px 0;">Past Stays (<%= pastBookings.length %>)</h2>
      <div class="booking-grid">
        <% pastBookings.forEach(function(booking) { %>
          <% const listing = booking.listing; %>
          <div class="card booking-list-card" style="opacity: 0.95;">
            <div class="booking-card-media">
              <% if (listing && listing.images && listing.images.length > 0) { %>
                <img src="<%= listing.images[0] %>" alt="<%= listing.title %>" />
              <% } else { %>
                <div class="listing-card-placeholder">No Image</div>
              <% } %>
            </div>

            <div class="booking-card-details">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                <div>
                  <h3 style="margin: 0 0 4px 0;">
                    <% if (listing) { %>
                      <a href="/listings/<%= listing._id %>" style="color: var(--forest-green); text-decoration: none;">
                        <%= listing.title %>
                      </a>
                    <% } else { %>
                      Deleted Property
                    <% } %>
                  </h3>
                  <% if (listing) { %>
                    <p style="color: #666; margin: 0; font-size: 0.9rem;">📍 <%= listing.location %>, <%= listing.country %></p>
                  <% } %>
                </div>
                <span class="badge badge-booking-status badge-completed">COMPLETED</span>
              </div>

              <hr style="border: none; border-top: 1px solid #eee; margin: 12px 0;" />

              <div class="booking-meta-grid">
                <div>
                  <span class="booking-meta-label">STAYED</span>
                  <span class="booking-meta-value"><%= booking.checkIn.toDateString() %></span>
                </div>
                <div>
                  <span class="booking-meta-label">DURATION</span>
                  <span class="booking-meta-value"><%= booking.nights %> nights · ₹<%= booking.totalPrice.toLocaleString() %></span>
                </div>
              </div>

              <div class="booking-card-actions" style="margin-top: 14px;">
                <a href="/bookings/<%= booking._id %>" class="btn btn-secondary" style="padding: 4px 12px; font-size: 0.85rem;">
                  View Summary
                </a>
                <% if (listing) { %>
                  <a href="/listings/<%= listing._id %>" class="btn btn-primary" style="padding: 4px 12px; font-size: 0.85rem;">
                    Book Again
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <%# ========== CANCELLED STAYS (If Any) ========== %>
  <% if (cancelledBookings.length > 0) { %>
    <div class="card" style="padding: 24px;">
      <h3 style="color: #721c24; margin: 0 0 12px 0;">Cancelled Reservations (<%= cancelledBookings.length %>)</h3>
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <% cancelledBookings.forEach(function(booking) { %>
          <% const listing = booking.listing; %>
          <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; background: #fdf7f7; border-radius: 6px; flex-wrap: wrap; gap: 8px;">
            <div>
              <strong><%= listing ? listing.title : 'Deleted Property' %></strong>
              <span style="color: #666; font-size: 0.85rem; margin-left: 8px;">
                <%= booking.checkIn.toDateString() %> – <%= booking.checkOut.toDateString() %>
              </span>
            </div>
            <div style="display: flex; align-items: center; gap: 10px;">
              <span class="badge badge-booking-status badge-cancelled">CANCELLED</span>
              <a href="/bookings/<%= booking._id %>" style="color: var(--forest-green); font-size: 0.85rem; font-weight: 600;">Details</a>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

</section>