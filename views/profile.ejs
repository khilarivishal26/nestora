<% layout("layouts/boilerplate") %>

<section class="container" style="padding: 60px 24px;">
  <div class="card" style="max-width: 480px; margin: 0 auto;">
    <h1 style="color: var(--forest-green); margin-top: 0;">Welcome, <%= currentUser.username %></h1>

    <p><strong>Email:</strong> <%= currentUser.email %></p>
    <p><strong>Role:</strong> <%= currentUser.role %></p>
    <p><strong>Joined:</strong> <%= currentUser.createdAt.toDateString() %></p>

    <% if (currentUser.role === "guest") { %>
      <div style="margin-top: 20px; padding: 16px; background: #e3f0e9; border-radius: var(--radius);">
        <p style="margin: 0 0 12px 0;"><strong>Want to list your property on Nestora?</strong></p>
        <form action="/become-host" method="POST">
          <button type="submit" class="btn btn-primary">Become a Host</button>
        </form>
      </div>
    <% } else if (currentUser.role === "host" || currentUser.role === "admin") { %>
      <div style="margin-top: 20px; display: flex; gap: 12px; flex-wrap: wrap;">
        <a href="/listings/my" class="btn btn-primary">My Properties</a>
        <a href="/listings/new" class="btn btn-secondary">+ Add Property</a>
      </div>
    <% } %>
  </div>
</section>