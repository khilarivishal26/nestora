<%# connect-flash / res.locals.success / res.locals.error are wired up
    in the session/auth step. Until then these locals are undefined,
    so the guards below simply render nothing. %>
<% if (typeof success !== "undefined" && success && success.length) { %>
  <div class="flash-container">
    <div class="flash-message flash-success"><%= success %></div>
  </div>
<% } %>
<% if (typeof error !== "undefined" && error && error.length) { %>
  <div class="flash-container">
    <div class="flash-message flash-error"><%= error %></div>
  </div>
<% } %>