<nav class="navbar">
  <div class="container">
    <a href="/" class="navbar-brand">Nestora</a>
    <ul class="navbar-links">
      <li><a href="/listings">Explore</a></li>

      <%# currentUser is not yet set anywhere - it will become available
          once Passport middleware is added later in Phase 1. Until then
          this always falls through to the logged-out links below. %>
      <% if (typeof currentUser !== "undefined" && currentUser) { %>

        <li><a href="/bookings/my">My Trips</a></li>

        <% if (currentUser.role === "host" || currentUser.role === "admin") { %>
          <li><a href="/host/dashboard">Host Dashboard</a></li>
          <li><a href="/listings/new">+ Add Stay</a></li>
        <% } %>

        <% if (currentUser.role === "admin") { %>
          <li><a href="/admin">Admin Center</a></li>
        <% } %>

        <li><a href="/profile">Hi, <%= currentUser.username %></a></li>
        <li>
          <form action="/logout" method="POST" style="display:inline">
            <button type="submit" class="link-button">Logout</button>
          </form>
        </li>
      <% } else { %>
        <li><a href="/login">Login</a></li>
        <li><a href="/register" class="btn-cta">Register</a></li>
      <% } %>
    </ul>
  </div>
</nav>