<footer class="footer-v2">
  <div class="container">
    <div class="footer-grid">

      <%# Col 1: Brand %>
      <div class="footer-col brand-col">
        <a href="/" class="footer-logo">Nestora</a>
        <p class="footer-desc">
          A premium multi-vendor hotel and stay booking marketplace connecting travelers with unique accommodations worldwide.
        </p>
        <div class="footer-badges">
          <span class="badge" style="background: rgba(255,255,255,0.1); color: var(--cream); font-size: 0.78rem;">
            🔒 256-Bit SSL Secured
          </span>
          <span class="badge" style="background: rgba(255,255,255,0.1); color: var(--cream); font-size: 0.78rem;">
            💳 Powered by Stripe
          </span>
        </div>
      </div>

      <%# Col 2: Explore %>
      <div class="footer-col">
        <h4>Explore Stays</h4>
        <ul>
          <li><a href="/listings">All Accommodations</a></li>
          <li><a href="/listings?propertyType=villa">Private Villas</a></li>
          <li><a href="/listings?propertyType=cottage">Boutique Cottages</a></li>
          <li><a href="/listings?propertyType=resort">Luxury Resorts</a></li>
          <li><a href="/listings?propertyType=heritage">Heritage Havelis</a></li>
        </ul>
      </div>

      <%# Col 3: Hosting %>
      <div class="footer-col">
        <h4>Host With Us</h4>
        <ul>
          <li><a href="/become-host">Become a Host</a></li>
          <li><a href="/listings/new">+ List Your Space</a></li>
          <li><a href="/host/dashboard">Host Dashboard</a></li>
          <li><a href="/bookings/host">Reservations Management</a></li>
        </ul>
      </div>

      <%# Col 4: Account & Legal %>
      <div class="footer-col">
        <h4>Account & Trust</h4>
        <ul>
          <li><a href="/profile">My Account & Trips</a></li>
          <li><a href="/bookings/my">Reservation Receipts</a></li>
