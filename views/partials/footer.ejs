            <li><a href="/admin">Admin Control Center</a></li>
          <% } %>
          <li><a href="/listings">Verified Stay Reviews</a></li>
        </ul>
      </div>

    </div>

    <div class="footer-bottom">
      <div>
        &copy; <%= new Date().getFullYear() %> <strong>Nestora</strong>. Find your place. Feel at home. All rights reserved.
      </div>
      <div class="footer-bottom-links">
        <a href="/listings">Browse</a>
        <span>·</span>
        <a href="/profile">Dashboard</a>
        <span>·</span>
        <a href="/become-host">Host</a>
