<% layout("layouts/boilerplate") %>

<section class="container" style="padding: 40px 24px;">

  <%# Header %>
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 28px;">
    <div>
      <h1 style="color: var(--forest-green); margin: 0 0 6px 0;">Host Dashboard</h1>
      <p style="color: #666; margin: 0;">Welcome back, <strong><%= currentUser.username %></strong>. Here is your hosting overview.</p>
    </div>
    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
      <a href="/listings/new" class="btn btn-primary">+ Add New Property</a>
      <a href="/listings/my" class="btn btn-secondary">My Properties</a>
    </div>
  </div>

  <%# Metric KPI Cards %>
  <div class="dashboard-stats-grid" style="margin-bottom: 32px;">
    <div class="card dashboard-stat-card">
      <span class="dashboard-stat-label">TOTAL EARNINGS</span>
      <span class="dashboard-stat-value" style="color: var(--forest-green);">₹<%= totalRevenue.toLocaleString() %></span>
      <span class="dashboard-stat-sub"><%= totalReservations %> total reservations</span>
    </div>

    <div class="card dashboard-stat-card">
      <span class="dashboard-stat-label">PROPERTIES</span>
      <span class="dashboard-stat-value"><%= totalProperties %></span>
      <span class="dashboard-stat-sub">
        <strong style="color: #155724;"><%= approvedProperties %> live</strong> · 
        <strong style="color: #856404;"><%= pendingProperties %> pending</strong>
      </span>
    </div>

    <div class="card dashboard-stat-card">
      <span class="dashboard-stat-label">UPCOMING STAYS</span>
      <span class="dashboard-stat-value" style="color: var(--terracotta);"><%= upcomingCount %></span>
      <span class="dashboard-stat-sub">Confirmed future guest trips</span>
    </div>

    <div class="card dashboard-stat-card">
      <span class="dashboard-stat-label">COMPLETED STAYS</span>
      <span class="dashboard-stat-value"><%= completedCount %></span>
      <span class="dashboard-stat-sub">Past guest checkouts</span>
    </div>
  </div>

  <%# Properties Management Section %>
  <div class="card" style="padding: 28px; margin-bottom: 32px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
      <div>
        <h2 style="color: var(--forest-green); margin: 0 0 4px 0;">My Properties (<%= totalProperties %>)</h2>
        <p style="color: #666; margin: 0; font-size: 0.95rem;">Manage your accommodation listings and approval statuses.</p>
      </div>
      <a href="/listings/new" class="btn btn-primary">+ List Property</a>
    </div>

    <% if (listings.length === 0) { %>
      <div style="text-align: center; padding: 40px 20px; background: #fdfaf6; border-radius: var(--radius);">
        <p style="color: #666; font-size: 1.05rem; margin: 0 0 16px 0;">You have not added any properties yet.</p>
        <a href="/listings/new" class="btn btn-primary">List Your First Property</a>
      </div>
    <% } else { %>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Property</th>
              <th>Type</th>
              <th>Location</th>
              <th>Price/Night</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% listings.forEach(function(listing) { %>
              <tr>
                <td>
                  <div class="admin-table-property">
                    <div class="admin-table-thumb">
                      <% if (listing.images && listing.images.length > 0) { %>
                        <img src="<%= listing.images[0] %>" alt="<%= listing.title %>" />
                      <% } else { %>
                        <div class="listing-card-placeholder">No Image</div>
                      <% } %>
                    </div>
                    <div>
                      <strong>
                        <a href="/listings/<%= listing._id %>" style="color: var(--forest-green); text-decoration: none;">
                          <%= listing.title %>
                        </a>
                      </strong>
                      <div style="color: #666; font-size: 0.85rem;">
                        👥 <%= listing.maxGuests %> guests · 🛏️ <%= listing.bedrooms %> beds
                      </div>
                    </div>
                  </div>
                </td>
                <td><span class="badge badge-type" style="text-transform: capitalize;"><%= listing.propertyType %></span></td>
                <td><%= listing.location %>, <%= listing.country %></td>
                <td><strong>₹<%= listing.price.toLocaleString() %></strong></td>
                <td>
                  <span class="badge badge-status badge-<%= listing.status %>">
                    <%= listing.status.toUpperCase() %>
                  </span>
                </td>
                <td>
                  <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                    <a href="/listings/<%= listing._id %>" class="btn btn-secondary" style="padding: 4px 10px; font-size: 0.85rem;">View</a>
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-primary" style="padding: 4px 10px; font-size: 0.85rem;">Edit</a>
                    <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST"
                          onsubmit="return confirm('Are you sure you want to delete this property?');">
                      <button type="submit" class="btn btn-danger" style="padding: 4px 10px; font-size: 0.85rem;">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <%# Incoming Guest Reservations Section %>
  <div class="card" style="padding: 28px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
      <div>
        <h2 style="color: var(--forest-green); margin: 0 0 4px 0;">Incoming Guest Reservations (<%= bookings.length %>)</h2>
        <p style="color: #666; margin: 0; font-size: 0.95rem;">Review guest bookings and payout details for your properties.</p>
      </div>
      <a href="/bookings/host" class="btn btn-secondary">Full Reservations View</a>
    </div>

    <% if (bookings.length === 0) { %>
      <div style="text-align: center; padding: 40px 20px; background: #fdfaf6; border-radius: var(--radius);">
        <p style="color: #666; font-size: 1.05rem; margin: 0;">No guest reservations recorded yet.</p>
      </div>
    <% } else { %>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Property</th>
              <th>Guest</th>
              <th>Stay Dates</th>
              <th>Nights & Guests</th>
              <th>Payout</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% bookings.forEach(function(booking) { %>
              <% const listing = booking.listing; %>
              <tr>
                <td>
                  <strong>
                    <% if (listing) { %>
                      <a href="/listings/<%= listing._id %>" style="color: var(--forest-green); text-decoration: none;">
                        <%= listing.title %>
                      </a>
                    <% } else { %>
                      Deleted Property
                    <% } %>
                  </strong>
                  <% if (listing) { %>
                    <div style="color: #666; font-size: 0.85rem;"><%= listing.location %></div>
                  <% } %>
                </td>
                <td>
                  <strong><%= booking.guest ? booking.guest.username : 'N/A' %></strong>
                  <div style="color: #666; font-size: 0.85rem;"><%= booking.guest ? booking.guest.email : '' %></div>
                </td>
                <td>
                  <strong><%= booking.checkIn.toDateString() %></strong><br />
                  <span style="color: #666; font-size: 0.85rem;">to <%= booking.checkOut.toDateString() %></span>
                </td>
                <td>
                  <%= booking.nights %> night<%= booking.nights !== 1 ? 's' : '' %><br />
                  <span style="color: #666; font-size: 0.85rem;"><%= booking.guests %> guest<%= booking.guests !== 1 ? 's' : '' %></span>
                </td>
                <td>
                  <strong style="color: var(--forest-green); font-size: 1.05rem;">
                    ₹<%= (booking.nights * booking.pricePerNight).toLocaleString() %>
                  </strong>
                </td>
                <td>
                  <div style="display: flex; flex-direction: column; gap: 4px;">
                    <span class="badge badge-booking-status badge-<%= booking.status %>">
                      <%= booking.status.toUpperCase() %>
                    </span>
                    <span class="badge badge-booking-status <%= booking.paymentStatus === 'paid' ? 'badge-confirmed' : 'badge-pending' %>" style="font-size: 0.7rem; padding: 2px 6px;">
                      💳 <%= (booking.paymentStatus || 'pending').toUpperCase() %>
                    </span>
                  </div>
                </td>
                <td>
                  <a href="/bookings/<%= booking._id %>" class="btn btn-secondary" style="padding: 4px 12px; font-size: 0.85rem;">
                    View Details
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

</section>
